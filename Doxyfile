# Doxyfile 1.9.5

# Project related configuration options
PROJECT_NAME           = "BMP Image Processing"
PROJECT_BRIEF          = "Library for BMP image rotation and Gaussian filtering"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# Build related configuration options
INPUT                  = ./src ./include
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES
EXCLUDE                = docs

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# HTML output options
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Warnings and errors
WARNINGS            = YES
QUIET               = NO

WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR    = NO
WARN_NO_PARAMDOC     = NO
WARN_IF_INCOMPLETE_DOC = NO


# Miscellaneous
GENERATE_TREEVIEW      = YES

